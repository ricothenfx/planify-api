# App
SECRET_KEY=your-secret-key-min-32-chars-here
FRONTEND_URL=http://localhost:5173

# Database (handled by docker-compose)
DATABASE_URL=postgresql+asyncpg://planify:planify123@postgres:5432/planify_db

# Redis (handled by docker-compose)
REDIS_URL=redis://redis:6379

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Account Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# AI (Google AI Studio - free tier available)
# Get your key at: https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# File Storage (Cloudinary - free tier available)
# Get your credentials at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email (Resend - free tier: 3000 emails/month)
# Get your key at: https://resend.com
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev